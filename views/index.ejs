<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span class="brand-icon">💼</span>
        <span>CareersHub</span>
      </a>
      <ul class="nav-links">
        <li>
          <a href="/" class="nav-link active">
            <span>Apply Now</span>
          </a>
        </li>
        <li>
          <a href="/applications" class="nav-link">
            <span>Submitted Applications</span>
            <span class="nav-badge"><%= totalApplications %></span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="container">
    <div class="page-header">
      <h1 class="page-title">Job Application Portal</h1>
      <p class="page-subtitle">
        Join our innovative engineering and product teams. Complete the application form below.
      </p>
      <div class="badge-info-pill">
        <span>🛡️ Protected with Node.js Server-Side Validation</span>
      </div>
    </div>

    <!-- Error Summary Alert Banner -->
    <% if (errors && Object.keys(errors).length > 0) { %>
      <div class="alert alert-danger" role="alert">
        <span class="alert-icon">⚠️</span>
        <div>
          <strong>Please correct the following <%= Object.keys(errors).length %> error(s):</strong>
          <ul>
            <% for (let field in errors) { %>
              <li><%= errors[field] %></li>
            <% } %>
          </ul>
        </div>
      </div>
    <% } %>

    <div class="card">
      <!-- novalidate disables client browser bubbles so Node.js server validation handles all checks -->
      <form action="/apply" method="POST" novalidate>
        <div class="form-grid">

          <!-- 1. Full Name -->
          <div class="form-group">
            <label for="fullName" class="form-label">
              <span>Full Name <span class="req-star">*</span></span>
              <span class="form-hint">Min 3 characters</span>
            </label>
            <input 
              type="text" 
              id="fullName" 
              name="fullName" 
              class="form-control <%= errors.fullName ? 'is-invalid' : '' %>" 
              placeholder="e.g. Eleanor Vance" 
              value="<%= formData.fullName || '' %>"
            >
            <% if (errors.fullName) { %>
              <div class="error-feedback">
                <span>✕</span> <%= errors.fullName %>
              </div>
            <% } %>
          </div>

          <!-- 2. Email Address -->
          <div class="form-group">
            <label for="email" class="form-label">
              <span>Email Address <span class="req-star">*</span></span>
              <span class="form-hint">Valid email format</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-control <%= errors.email ? 'is-invalid' : '' %>" 
              placeholder="e.g. eleanor@example.com" 
              value="<%= formData.email || '' %>"
            >
            <% if (errors.email) { %>
              <div class="error-feedback">
                <span>✕</span> <%= errors.email %>
              </div>
            <% } %>
          </div>

          <!-- 3. Phone Number -->
          <div class="form-group">
            <label for="phone" class="form-label">
              <span>Phone Number <span class="req-star">*</span></span>
              <span class="form-hint">Exactly 10 digits</span>
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              maxlength="10"
              class="form-control <%= errors.phone ? 'is-invalid' : '' %>" 
              placeholder="e.g. 9876543210" 
              value="<%= formData.phone || '' %>"
            >
            <% if (errors.phone) { %>
              <div class="error-feedback">
                <span>✕</span> <%= errors.phone %>
              </div>
            <% } %>
          </div>

          <!-- 4. Position Applied For -->
          <div class="form-group">
            <label for="position" class="form-label">
              <span>Position Applied For <span class="req-star">*</span></span>
              <span class="form-hint">Select a role</span>
            </label>
            <select 
              id="position" 
              name="position" 
              class="form-control <%= errors.position ? 'is-invalid' : '' %>"
            >
              <option value="">-- Select a Position --</option>
              <% positions.forEach(function(pos) { %>
                <option value="<%= pos %>" <%= (formData.position === pos) ? 'selected' : '' %>>
                  <%= pos %>
                </option>
              <% }); %>
            </select>
            <% if (errors.position) { %>
              <div class="error-feedback">
                <span>✕</span> <%= errors.position %>
              </div>
            <% } %>
          </div>

          <!-- 5. Years of Experience -->
          <div class="form-group full-width">
            <label for="experience" class="form-label">
              <span>Years of Experience <span class="req-star">*</span></span>
              <span class="form-hint">Cannot be negative</span>
            </label>
            <input 
              type="number" 
              id="experience" 
              name="experience" 
              min="0"
              step="any"
              class="form-control <%= errors.experience ? 'is-invalid' : '' %>" 
              placeholder="e.g. 3 (enter 0 if fresher)" 
              value="<%= formData.experience !== undefined ? formData.experience : '' %>"
            >
            <% if (errors.experience) { %>
              <div class="error-feedback">
                <span>✕</span> <%= errors.experience %>
              </div>
            <% } %>
          </div>

          <!-- 6. Cover Letter -->
          <div class="form-group full-width">
            <label for="coverLetter" class="form-label">
              <span>Cover Letter <span class="req-star">*</span></span>
              <span class="form-hint">Min 50 characters</span>
            </label>
            <textarea 
              id="coverLetter" 
              name="coverLetter" 
              rows="5" 
              class="form-control <%= errors.coverLetter ? 'is-invalid' : '' %>" 
              placeholder="Describe your background, skills, and why you are the ideal candidate for this role..."
            ><%= formData.coverLetter || '' %></textarea>
            
            <div class="textarea-footer">
              <% if (errors.coverLetter) { %>
                <div class="error-feedback">
                  <span>✕</span> <%= errors.coverLetter %>
                </div>
              <% } else { %>
                <div></div>
              <% } %>
              <span id="charCounter" class="char-counter">0 / 50 characters</span>
            </div>
          </div>

        </div>

        <!-- Form Actions -->
        <div class="form-actions">
          <a href="/" class="btn btn-secondary">Reset Form</a>
          <button type="submit" class="btn btn-primary">
            <span>Submit Application</span>
            <span>➔</span>
          </button>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> CareersHub Portal &bull; Built with Node.js &amp; Express Server-Side Validation</p>
  </footer>

  <script>
    // Live character counter helper for Cover Letter
    const coverLetterInput = document.getElementById('coverLetter');
    const charCounter = document.getElementById('charCounter');

    function updateCounter() {
      const len = coverLetterInput.value.trim().length;
      charCounter.textContent = `${len} / 50 characters`;
      if (len >= 50) {
        charCounter.className = 'char-counter valid';
      } else if (len > 0) {
        charCounter.className = 'char-counter invalid';
      } else {
        charCounter.className = 'char-counter';
      }
    }

    coverLetterInput.addEventListener('input', updateCounter);
    // Initialize counter on page load (especially after server-side validation error preserves text)
    updateCounter();
  </script>
</body>
</html>
