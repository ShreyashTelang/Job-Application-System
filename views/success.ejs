<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span class="brand-icon">💼</span>
        <span>CareersHub</span>
      </a>
      <ul class="nav-links">
        <li>
          <a href="/" class="nav-link">
            <span>Apply Now</span>
          </a>
        </li>
        <li>
          <a href="/applications" class="nav-link">
            <span>Submitted Applications</span>
            <span class="nav-badge"><%= totalApplications %></span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Main Container -->
  <main class="container">
    <div class="card success-card">
      <div class="success-icon-wrap">
        <span>✓</span>
      </div>

      <h1 class="page-title" style="color: var(--success); margin-bottom: 0.5rem;">
        Application Received!
      </h1>
      <p class="page-subtitle">
        Your job application has passed server-side validation and was successfully recorded in our system.
      </p>

      <!-- Details Summary -->
      <div class="detail-table">
        <div class="detail-row">
          <div class="detail-label">Application ID</div>
          <div class="detail-value">
            <strong style="color: var(--primary);"><%= application.id %></strong>
          </div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Applicant Name</div>
          <div class="detail-value"><strong><%= application.fullName %></strong></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Email Address</div>
          <div class="detail-value"><%= application.email %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Phone Number</div>
          <div class="detail-value"><%= application.phone %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Position Applied For</div>
          <div class="detail-value">
            <span class="app-badge-pos"><%= application.position %></span>
          </div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Experience</div>
          <div class="detail-value">
            <span class="app-badge-exp"><%= application.experience %> Year(s)</span>
          </div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Submitted On</div>
          <div class="detail-value"><%= application.submittedAt %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Cover Letter</div>
          <div class="detail-value" style="font-size: 0.9rem; color: #475569; white-space: pre-line;">
            <%= application.coverLetter %>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
        <a href="/applications" class="btn btn-primary">
          <span>📋 View All Applications (<%= totalApplications %>)</span>
        </a>
        <a href="/" class="btn btn-secondary">
          <span>➕ Submit Another Application</span>
        </a>
      </div>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> CareersHub Portal &bull; Built with Node.js &amp; Express</p>
  </footer>

</body>
</html>
